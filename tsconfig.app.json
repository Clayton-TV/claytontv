{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "resources/js/**/*",
    "resources/js/**/*.vue"
  ],
  "exclude": [
    "resources/js/**/__tests__/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "types": [
      "vite/client",
      "./resources/js/types"
    ],
    "paths": {
      "@/*": ["./resources/js/components/*"],
      "~/*": ["./resources/js/*"],
      "ziggy-js": ["./vendor/tightenco/ziggy"]
    }
  }
}
